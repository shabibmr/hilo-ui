# Supabase configuration for Hilo Admin
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional base path if hosted on a sub-path (e.g., /admin)
# NEXT_PUBLIC_BASE_PATH=/admin

# Optional: comma-separated emails allowed into the admin UI (RLS is the real guard)
# NEXT_PUBLIC_ADMIN_EMAILS=owner@example.com

# Data backend: 'supabase' (direct, default) or 'api' (Hilo API). In api mode sign-in stays on Supabase Auth and data calls go to the API.
NEXT_PUBLIC_DATA_MODE=supabase
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
