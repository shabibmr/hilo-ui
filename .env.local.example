# Hilo Arte Storefront Environment Configuration

# Provider selection. 'mock' is for local development ONLY. Production builds must set
# the provider explicitly (the build fails if unset). Opt into the read API with "api".
DATA_PROVIDER=mock
NEXT_PUBLIC_DATA_PROVIDER=mock

# Read API base URL (no trailing slash). Required when NEXT_PUBLIC_DATA_PROVIDER=api.
# Example local: http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Supabase Credentials (obtain from supabase.com project dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Razorpay Test Key (used for checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Checkout backend: 'edge' (Supabase Edge Function, default) or 'api' (Hilo API /api/v1/checkout/orders).
NEXT_PUBLIC_CHECKOUT_MODE=edge

# Base path the static export is served under. Default /hilo. Set to /hilo/store after Stage 1 relocation
# (use the full sub-path, e.g. /algo_cloud/hilo/store if that is the public URL prefix).
# NEXT_PUBLIC_BASE_PATH=/hilo/store
