# Hilo Arte Storefront Environment Configuration
# The storefront talks only to the Hilo API (server/). For local development run server/
# against a development Supabase project (see server/README.md), then point this at it.

# Hilo API base URL (no trailing slash). Required: the build fails if unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Razorpay Test Key (used for checkout)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Base path the static export is served under. Default /hilo. Set to /hilo/store after Stage 1 relocation
# (use the full sub-path, e.g. /algo_cloud/hilo/store if that is the public URL prefix).
# NEXT_PUBLIC_BASE_PATH=/hilo/store
