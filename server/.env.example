# Required
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
PORT=4000
NODE_ENV=development

# Production: comma-separated storefront and admin origins (no wildcard).
# Example: CORS_ORIGIN=https://example.com,https://example.com
# Local/dev may use * (reflect any). Production with * logs a warning.
CORS_ORIGIN=*

# Admin guard (comma-separated Supabase user ids). Empty = nobody is admin.
# ADMIN_USER_IDS=

# Razorpay (checkout + webhooks + admin refund/verify)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
